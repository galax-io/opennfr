{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opennfr.io/schema/v1/evaluationreport.schema.json",
  "title": "EvaluationReport",
  "description": "What one evaluation produced. The format's second container, and just as minimal: without a standard output, 'any backend can consume this' is half a promise.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "const": "opennfr.io/v1"
    },
    "kind": {
      "const": "EvaluationReport"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "$ref": "https://opennfr.io/schema/v1/common.schema.json#/$defs/name"
        },
        "annotations": {
          "$ref": "https://opennfr.io/schema/v1/common.schema.json#/$defs/annotations"
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirementSetRef",
        "outcome",
        "verdicts"
      ],
      "properties": {
        "requirementSetRef": {
          "$ref": "https://opennfr.io/schema/v1/common.schema.json#/$defs/name"
        },
        "run": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "attributes": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              },
              "description": "Run identity, expressed with existing OpenTelemetry attributes only — service.name, cicd.pipeline.run.id, vcs.ref.head.revision. The format defines no identity field of its own, which is what lets a report correlate with the traces of the same run without glue."
            }
          }
        },
        "outcome": {
          "enum": [
            "pass",
            "fail",
            "inconclusive"
          ],
          "description": "inconclusive is a first-class outcome, not a flavour of fail. It means the test did not happen, which is a different engineering decision from the system not holding."
        },
        "verdicts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/verdict"
          }
        }
      }
    }
  },
  "$defs": {
    "verdict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirement",
        "criterionId",
        "section",
        "status"
      ],
      "properties": {
        "requirement": {
          "$ref": "https://opennfr.io/schema/v1/common.schema.json#/$defs/name"
        },
        "criterionId": {
          "type": "string",
          "minLength": 1,
          "description": "The predicate's name if it has one, otherwise its aggregation. Never an index: an index breaks the moment the file is edited."
        },
        "section": {
          "enum": [
            "criteria",
            "guards"
          ]
        },
        "status": {
          "enum": [
            "pass",
            "fail",
            "noData"
          ],
          "description": "noData is not a success. Missing data is an outcome in its own right, never a silent green."
        },
        "observed": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "unit"
          ],
          "properties": {
            "value": {
              "type": "number"
            },
            "unit": {
              "$ref": "https://opennfr.io/schema/v1/common.schema.json#/$defs/unit"
            }
          }
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "description": "A verdict that judged something must say what it measured, or the result has to be taken on trust.",
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "pass",
                  "fail"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "observed"
            ]
          }
        },
        {
          "description": "No Silent Green, made mechanical: a verdict that produced no judgement must say why, or silence is indistinguishable from success.",
          "if": {
            "properties": {
              "status": {
                "const": "noData"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "reason"
            ]
          }
        }
      ]
    }
  }
}
