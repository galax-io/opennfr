{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opennfr.io/schema/v1/requirementset.schema.json",
  "title": "RequirementSet",
  "description": "The container a performance requirement is written into. It fixes the shape, not the vocabulary: metric and attribute names are plain strings here, because they are borrowed from OpenTelemetry semantic conventions rather than defined by this format.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "const": "opennfr.io/v1"
    },
    "kind": {
      "const": "RequirementSet"
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirements"
      ],
      "properties": {
        "defaults": {
          "$ref": "#/$defs/defaults"
        },
        "requirements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/requirement"
          }
        },
        "gate": {
          "$ref": "#/$defs/gate"
        }
      }
    }
  },
  "$defs": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/name"
        },
        "displayName": {
          "type": "string"
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "The only extension point. The opennfr.io/ prefix is reserved."
        }
      }
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$",
      "maxLength": 253
    },
    "selector": {
      "type": "object",
      "description": "Selects time series by attribute. {} means every series. A value of \"*\" means the attribute is present with any value. Attribute names are not enumerated here — they come from OpenTelemetry.",
      "additionalProperties": {
        "type": "string"
      }
    },
    "series": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric",
        "selector"
      ],
      "properties": {
        "metric": {
          "type": "string",
          "minLength": 1,
          "description": "A metric name, borrowed from OpenTelemetry semantic conventions where one exists. This schema does not enumerate metric names and never will: enumerating them would make every new metric a change to the format."
        },
        "selector": {
          "$ref": "#/$defs/selector"
        }
      }
    },
    "indicator": {
      "type": "object",
      "additionalProperties": false,
      "description": "Exactly one shape. Nested keys rather than a discriminator, so a decoder needs no two-pass parsing.",
      "properties": {
        "distribution": {
          "$ref": "#/$defs/series"
        },
        "ratio": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "total"
          ],
          "properties": {
            "total": {
              "$ref": "#/$defs/series"
            },
            "bad": {
              "$ref": "#/$defs/series"
            },
            "good": {
              "$ref": "#/$defs/series"
            }
          },
          "oneOf": [
            {
              "required": [
                "bad"
              ]
            },
            {
              "required": [
                "good"
              ]
            }
          ]
        }
      },
      "oneOf": [
        {
          "required": [
            "distribution"
          ]
        },
        {
          "required": [
            "ratio"
          ]
        }
      ]
    },
    "aggregation": {
      "type": "string",
      "anyOf": [
        {
          "enum": [
            "avg",
            "min",
            "max",
            "count",
            "rate",
            "sum",
            "stddev"
          ]
        },
        {
          "pattern": "^p\\d{1,2}(\\.\\d+)?$"
        }
      ]
    },
    "op": {
      "enum": [
        "lt",
        "lte",
        "gt",
        "gte",
        "eq",
        "neq"
      ]
    },
    "unit": {
      "type": "string",
      "minLength": 1,
      "description": "Mandatory. Without it 0.1 is either a tenth of a percent or a tenth of a fraction and nobody can tell. The permitted set is a closed list once docs/units.md is ratified; until then any non-empty string parses."
    },
    "severity": {
      "enum": [
        "blocker",
        "warning",
        "info"
      ]
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "phase": {
          "enum": [
            "rampUp",
            "steady",
            "rampDown",
            "full"
          ]
        },
        "rolling": {
          "type": "string",
          "pattern": "^\\d+(ms|s|m|h)$"
        }
      }
    },
    "predicate": {
      "type": "object",
      "description": "The shared shape of a criterion and a guard: aggregation, comparison, and a bar. The bar is either an absolute threshold or a baseline plus a tolerance, never both.",
      "required": [
        "aggregation",
        "op"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/name"
        },
        "description": {
          "type": "string"
        },
        "aggregation": {
          "$ref": "#/$defs/aggregation"
        },
        "op": {
          "$ref": "#/$defs/op"
        },
        "threshold": {
          "type": "number"
        },
        "baseline": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source"
          ],
          "properties": {
            "source": {
              "enum": [
                "previousPassed",
                "previous",
                "pinned"
              ]
            },
            "runId": {
              "type": "string"
            }
          }
        },
        "tolerance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "unit"
          ],
          "properties": {
            "value": {
              "type": "number"
            },
            "unit": {
              "$ref": "#/$defs/unit"
            }
          }
        },
        "unit": {
          "$ref": "#/$defs/unit"
        },
        "severity": {
          "$ref": "#/$defs/severity"
        },
        "window": {
          "$ref": "#/$defs/window"
        },
        "enforcement": {
          "enum": [
            "post",
            "inline",
            "both"
          ]
        },
        "onViolation": {
          "enum": [
            "continue",
            "abort"
          ]
        }
      },
      "oneOf": [
        {
          "required": [
            "threshold",
            "unit"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "baseline"
                ]
              },
              {
                "required": [
                  "tolerance"
                ]
              }
            ]
          },
          "description": "An absolute bar: the threshold needs a unit, or 0.1 is either a tenth of a percent or a tenth of a fraction."
        },
        {
          "required": [
            "baseline",
            "tolerance"
          ],
          "not": {
            "required": [
              "threshold"
            ]
          },
          "description": "A relative bar: tolerance.unit carries the unit, so the predicate needs none of its own. The direction follows from op."
        }
      ]
    },
    "criterion": {
      "allOf": [
        {
          "$ref": "#/$defs/predicate"
        }
      ],
      "unevaluatedProperties": false
    },
    "guard": {
      "description": "A criterion in shape, a precondition in meaning: a violated guard yields inconclusive, not fail. It may carry its own indicator when it measures something other than the requirement does.",
      "allOf": [
        {
          "$ref": "#/$defs/predicate"
        }
      ],
      "properties": {
        "indicator": {
          "$ref": "#/$defs/indicator"
        },
        "indicatorRef": {
          "$ref": "#/$defs/name"
        }
      },
      "not": {
        "required": [
          "indicator",
          "indicatorRef"
        ]
      },
      "unevaluatedProperties": false
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "criteria"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/name"
        },
        "displayName": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "indicator": {
          "$ref": "#/$defs/indicator"
        },
        "indicatorRef": {
          "$ref": "#/$defs/name"
        },
        "guards": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/guard"
          }
        },
        "criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/criterion"
          }
        }
      },
      "oneOf": [
        {
          "required": [
            "indicator"
          ]
        },
        {
          "required": [
            "indicatorRef"
          ]
        }
      ]
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "window": {
          "$ref": "#/$defs/window"
        },
        "severity": {
          "$ref": "#/$defs/severity"
        },
        "enforcement": {
          "enum": [
            "post",
            "inline",
            "both"
          ]
        },
        "onViolation": {
          "enum": [
            "continue",
            "abort"
          ]
        }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "description": "How many verdicts become one outcome. Every non-pass state needs a key, or silence decides it.",
      "properties": {
        "onBlocker": {
          "$ref": "#/$defs/outcome"
        },
        "onWarning": {
          "$ref": "#/$defs/outcome"
        },
        "onInfo": {
          "$ref": "#/$defs/outcome"
        },
        "onNoData": {
          "$ref": "#/$defs/outcome"
        },
        "onSkipped": {
          "$ref": "#/$defs/outcome"
        },
        "onGuardViolation": {
          "$ref": "#/$defs/outcome"
        }
      }
    },
    "outcome": {
      "enum": [
        "fail",
        "warn",
        "ignore",
        "inconclusive"
      ]
    }
  }
}
