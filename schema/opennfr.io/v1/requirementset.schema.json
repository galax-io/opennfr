{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opennfr.io/schema/v1/requirementset.schema.json",
  "title": "RequirementSet",
  "description": "The container a performance requirement is written into. Deliberately minimal: it fixes the shape and nothing else. Metric and attribute names are plain strings, borrowed from OpenTelemetry rather than defined here, so measuring something new never means changing the format.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "const": "opennfr.io/v1"
    },
    "kind": {
      "const": "RequirementSet"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "$ref": "https://opennfr.io/schema/v1/common.schema.json#/$defs/name"
        },
        "annotations": {
          "$ref": "https://opennfr.io/schema/v1/common.schema.json#/$defs/annotations"
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirements"
      ],
      "properties": {
        "requirements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/requirement"
          }
        }
      }
    }
  },
  "$defs": {
    "series": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric",
        "selector"
      ],
      "properties": {
        "metric": {
          "type": "string",
          "minLength": 1,
          "description": "A metric name, borrowed from OpenTelemetry semantic conventions where one exists. This schema does not enumerate metric names and never will: enumerating them would make every new metric a change to the format."
        },
        "selector": {
          "$ref": "https://opennfr.io/schema/v1/common.schema.json#/$defs/selector"
        }
      }
    },
    "indicator": {
      "type": "object",
      "additionalProperties": false,
      "description": "Exactly one shape. Nested keys rather than a discriminator, so a decoder needs no second pass.",
      "properties": {
        "distribution": {
          "$ref": "#/$defs/series"
        },
        "ratio": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "total",
            "bad"
          ],
          "properties": {
            "total": {
              "$ref": "#/$defs/series"
            },
            "bad": {
              "$ref": "#/$defs/series"
            }
          }
        }
      },
      "oneOf": [
        {
          "required": [
            "distribution"
          ]
        },
        {
          "required": [
            "ratio"
          ]
        }
      ]
    },
    "predicate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "aggregation",
        "op",
        "threshold",
        "unit"
      ],
      "properties": {
        "name": {
          "$ref": "https://opennfr.io/schema/v1/common.schema.json#/$defs/name",
          "description": "Optional. Identifies this predicate in a report; without it the aggregation is the identifier, so two predicates in one requirement may not then share an aggregation."
        },
        "aggregation": {
          "$ref": "https://opennfr.io/schema/v1/common.schema.json#/$defs/aggregation"
        },
        "op": {
          "$ref": "https://opennfr.io/schema/v1/common.schema.json#/$defs/op"
        },
        "threshold": {
          "type": "number"
        },
        "unit": {
          "$ref": "https://opennfr.io/schema/v1/common.schema.json#/$defs/unit"
        }
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "indicator",
        "criteria"
      ],
      "properties": {
        "name": {
          "$ref": "https://opennfr.io/schema/v1/common.schema.json#/$defs/name"
        },
        "indicator": {
          "$ref": "#/$defs/indicator"
        },
        "guards": {
          "type": "array",
          "minItems": 1,
          "description": "Preconditions. Same shape as a criterion, opposite meaning: a violated guard says the run did not happen as intended, so the outcome is inconclusive rather than fail. A guard may measure something the requirement does not, which is why it may carry its own indicator.",
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/predicate"
              }
            ],
            "properties": {
              "indicator": {
                "$ref": "#/$defs/indicator"
              }
            },
            "unevaluatedProperties": false
          }
        },
        "criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/predicate"
          }
        }
      }
    }
  }
}
