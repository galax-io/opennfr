# OS / editor
.DS_Store
*.swp
.idea/
.vscode/

# Claude Code local (keep settings.json + hooks tracked; ignore local/secret state)
.claude/settings.local.json
.claude/worktrees/

# spec-kit scratch (keep the installed config tracked; ignore per-checkout runtime state)
.specify/feature.json
scratchpad-*.sh
scratchpad-*.log
speckit-install.log

# python bytecode — scripts/verify.sh imports scripts/mdlinks.py
__pycache__/
*.pyc

# Spec Kit scripts run by Python
__pycache__/

# Spec Kit CLI state: it differs on every machine, and the kit (scripts/check-speckit.sh) leaves it out
.specify/extensions/.registry
.specify/extensions/.cache/
.specify/extensions/.backup/
.specify/presets/.registry
.specify/integrations/*.manifest.json
.specify/workflows/workflow-registry.json

# build output
# extend per stack: target/, build/, dist/, node_modules/, etc.

# Spec Kit: Python caches and the CLI state, which the kit does not ship (scripts/check-speckit.sh)
.specify/extensions/.registry
.specify/extensions/.cache/
.specify/extensions/.backup/
.specify/presets/.registry
.specify/integrations/*.manifest.json
.specify/workflows/workflow-registry.json
